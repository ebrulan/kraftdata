{
  "datasets": [
    {
      "name": "daily_price",
      "displayName": "Daily price per zone",
      "queryLines": [
        "SELECT\n",
        "  delivery_date AS day,\n",
        "  zone,\n",
        "  AVG(price_eur_mwh) AS avg_price_eur_mwh,\n",
        "  MIN(price_eur_mwh) AS min_price_eur_mwh,\n",
        "  MAX(price_eur_mwh) AS max_price_eur_mwh\n",
        "FROM dbw_kraftdata.bronze.entsoe_day_ahead_prices\n",
        "GROUP BY ALL\n"
      ]
    },
    {
      "name": "intraday_price",
      "displayName": "Prices today and tomorrow",
      "queryLines": [
        "SELECT\n",
        "  from_utc_timestamp(interval_start_utc, 'Europe/Oslo') AS local_time,\n",
        "  delivery_date AS day,\n",
        "  zone,\n",
        "  price_eur_mwh\n",
        "FROM dbw_kraftdata.bronze.entsoe_day_ahead_prices\n",
        "WHERE delivery_date >= current_date()\n"
      ]
    },
    {
      "name": "price_vs_temperature",
      "displayName": "Daily price vs temperature",
      "queryLines": [
        "WITH price AS (\n",
        "  SELECT delivery_date AS day, zone, AVG(price_eur_mwh) AS avg_price_eur_mwh\n",
        "  FROM dbw_kraftdata.bronze.entsoe_day_ahead_prices\n",
        "  GROUP BY ALL\n",
        "),\n",
        "temperature AS (\n",
        "  SELECT observation_date AS day, zone, city, AVG(air_temperature_c) AS avg_temperature_c\n",
        "  FROM dbw_kraftdata.bronze.frost_air_temperature\n",
        "  GROUP BY ALL\n",
        ")\n",
        "SELECT p.day, p.zone, t.city, p.avg_price_eur_mwh, t.avg_temperature_c\n",
        "FROM price p\n",
        "JOIN temperature t USING (day, zone)\n"
      ]
    },
    {
      "name": "latest_summary",
      "displayName": "Latest available day per zone",
      "queryLines": [
        "SELECT\n",
        "  zone,\n",
        "  delivery_date AS day,\n",
        "  ROUND(AVG(price_eur_mwh), 2) AS avg_price_eur_mwh,\n",
        "  ROUND(MIN(price_eur_mwh), 2) AS min_price_eur_mwh,\n",
        "  ROUND(MAX(price_eur_mwh), 2) AS max_price_eur_mwh\n",
        "FROM dbw_kraftdata.bronze.entsoe_day_ahead_prices\n",
        "WHERE delivery_date = (SELECT MAX(delivery_date) FROM dbw_kraftdata.bronze.entsoe_day_ahead_prices)\n",
        "GROUP BY ALL\n",
        "ORDER BY zone\n"
      ]
    }
  ],
