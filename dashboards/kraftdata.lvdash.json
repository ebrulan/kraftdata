{
  "datasets": [
    {
      "name": "daily_price",
      "displayName": "Daily price per zone",
      "queryLines": [
        "SELECT\n",
        "  delivery_date AS day,\n",
        "  price_area AS zone,\n",
        "  avg_price_ore_kwh,\n",
        "  min_price_ore_kwh,\n",
        "  max_price_ore_kwh,\n",
        "  avg_price_eur_mwh\n",
        "FROM dbw_kraftdata.marts.fct_spotpris_dag\n"
      ]
    },
    {
      "name": "intraday_price",
      "displayName": "Prices today and tomorrow",
      "queryLines": [
        "SELECT\n",
        "  p.interval_start_local AS local_time,\n",
        "  p.delivery_date AS day,\n",
        "  p.price_area AS zone,\n",
        "  p.price_eur_mwh * fx.eur_nok / 10 AS price_ore_kwh\n",
        "FROM dbw_kraftdata.staging.stg_spotpriser p\n",
        "JOIN dbw_kraftdata.intermediate.int_valutakurs_dag fx\n",
        "  ON fx.calendar_date = p.delivery_date\n",
        "WHERE p.delivery_date >= current_date()\n"
      ]
    },
    {
      "name": "price_vs_temperature",
      "displayName": "Daily price vs temperature",
      "queryLines": [
        "SELECT\n",
        "  delivery_date AS day,\n",
        "  price_area AS zone,\n",
        "  avg_price_ore_kwh,\n",
        "  avg_temperature_c\n",
        "FROM dbw_kraftdata.marts.fct_spotpris_dag\n",
        "WHERE temperature_hours = hours_in_day\n"
      ]
    },
    {
      "name": "latest_summary",
      "displayName": "Latest available day per zone",
      "queryLines": [
        "SELECT\n",
        "  f.price_area AS zone,\n",
        "  d.area_name,\n",
        "  f.delivery_date AS day,\n",
        "  ROUND(f.avg_price_ore_kwh, 1) AS avg_price_ore_kwh,\n",
        "  ROUND(f.min_price_ore_kwh, 1) AS min_price_ore_kwh,\n",
        "  ROUND(f.max_price_ore_kwh, 1) AS max_price_ore_kwh,\n",
        "  date_format(f.cheapest_hour_local, 'HH:mm') AS cheapest_hour,\n",
        "  date_format(f.most_expensive_hour_local, 'HH:mm') AS most_expensive_hour\n",
        "FROM dbw_kraftdata.marts.fct_spotpris_dag f\n",
        "JOIN dbw_kraftdata.marts.dim_prisomrade d USING (price_area)\n",
        "WHERE f.delivery_date = (SELECT MAX(delivery_date) FROM dbw_kraftdata.marts.fct_spotpris_dag)\n",
        "ORDER BY zone\n"
      ]
    },
    {
      "name": "forecast_series",
      "displayName": "NO2 forecast vs actual",
      "queryLines": [
        "SELECT target_date AS day, split, 'Actual' AS series, actual_ore_kwh AS ore_kwh\n",
        "FROM dbw_kraftdata.marts.fct_prognose WHERE price_area = 'NO2'\n",
        "UNION ALL\n",
        "SELECT target_date, split, 'LightGBM', forecast_lgbm_ore_kwh\n",
        "FROM dbw_kraftdata.marts.fct_prognose WHERE price_area = 'NO2'\n",
        "UNION ALL\n",
        "SELECT target_date, split, 'Naive (tomorrow = today)', forecast_naive_ore_kwh\n",
        "FROM dbw_kraftdata.marts.fct_prognose WHERE price_area = 'NO2'\n"
      ]
    },
    {
      "name": "forecast_accuracy",
      "displayName": "Forecast accuracy",
      "queryLines": [
        "SELECT\n",
        "  split,\n",
        "  COUNT(actual_eur_mwh) AS days,\n",
        "  ROUND(AVG(ABS(error_lgbm_eur_mwh)), 2) AS mae_lgbm_eur_mwh,\n",
        "  ROUND(AVG(ABS(error_naive_eur_mwh)), 2) AS mae_naive_eur_mwh,\n",
        "  ROUND(100 * (1 - AVG(ABS(error_lgbm_eur_mwh)) / AVG(ABS(error_naive_eur_mwh))), 1)\n",
        "    AS improvement_pct\n",
        "FROM dbw_kraftdata.marts.fct_prognose\n",
        "WHERE price_area = 'NO2' AND actual_eur_mwh IS NOT NULL\n",
        "GROUP BY split\n"
      ]
    },
    {
      "name": "forecast_next",
      "displayName": "Next-day forecast",
      "queryLines": [
        "SELECT target_date AS day, ROUND(forecast_lgbm_ore_kwh, 1) AS forecast_ore_kwh\n",
        "FROM dbw_kraftdata.marts.fct_prognose\n",
        "WHERE price_area = 'NO2' AND split = 'live'\n",
        "ORDER BY target_date DESC\n",
        "LIMIT 1\n"
      ]
    },
    {
      "name": "forecast_error_month",
      "displayName": "Monthly forecast error",
      "queryLines": [
        "SELECT\n",
        "  date_trunc('MONTH', target_date) AS month,\n",
        "  'LightGBM' AS model, AVG(ABS(error_lgbm_eur_mwh)) AS mae_eur_mwh\n",
        "FROM dbw_kraftdata.marts.fct_prognose\n",
        "WHERE price_area = 'NO2' AND actual_eur_mwh IS NOT NULL\n",
        "GROUP BY ALL\n",
        "UNION ALL\n",
        "SELECT date_trunc('MONTH', target_date), 'Naive', AVG(ABS(error_naive_eur_mwh))\n",
        "FROM dbw_kraftdata.marts.fct_prognose\n",
        "WHERE price_area = 'NO2' AND actual_eur_mwh IS NOT NULL\n",
        "GROUP BY ALL\n"
      ]
    }
  ],
